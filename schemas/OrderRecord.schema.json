{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "quoteId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "gerberSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "fileName": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "default": "CNY",
      "type": "string",
      "const": "CNY"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "file_issue",
        "awaiting_payment",
        "awaiting_production_file",
        "in_production",
        "ready_to_ship",
        "shipped",
        "delivered",
        "cancelled",
        "unknown"
      ]
    },
    "rawStatus": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "details": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "currency",
    "status",
    "rawStatus",
    "updatedAt",
    "details"
  ],
  "additionalProperties": false
}
