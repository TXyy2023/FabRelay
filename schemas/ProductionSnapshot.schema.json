{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "file_issue",
        "awaiting_payment",
        "awaiting_production_file",
        "in_production",
        "ready_to_ship",
        "shipped",
        "delivered",
        "cancelled",
        "unknown"
      ]
    },
    "rawStatus": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "time": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "rawStatus",
    "nodes"
  ],
  "additionalProperties": false
}
