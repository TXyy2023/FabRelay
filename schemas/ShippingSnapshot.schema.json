{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "not_shipped",
        "in_transit",
        "delivered",
        "exception",
        "unknown"
      ]
    },
    "carrier": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    },
    "rawStatus": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
