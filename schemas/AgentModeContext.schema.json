{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "hard",
        "simple"
      ]
    },
    "label": {
      "type": "string"
    },
    "globalPreferences": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "historySuggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "occurrences": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sampleSize": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "string",
            "const": "order-history"
          }
        },
        "required": [
          "key",
          "value",
          "occurrences",
          "sampleSize",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": "string"
    },
    "skillCommand": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "label",
    "globalPreferences",
    "historySuggestions",
    "precedence",
    "prompt",
    "skillCommand"
  ],
  "additionalProperties": false
}
