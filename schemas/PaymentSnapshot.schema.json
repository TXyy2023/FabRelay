{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "environment": {
      "type": "string",
      "const": "test"
    },
    "orderId": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "const": "CNY"
    },
    "method": {
      "type": "string",
      "const": "balance"
    },
    "rawOrderStatus": {
      "type": "string"
    },
    "pageFingerprint": {
      "type": "string"
    },
    "artifactPath": {
      "type": "string"
    },
    "preparedAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "environment",
    "orderId",
    "amount",
    "currency",
    "method",
    "rawOrderStatus",
    "pageFingerprint",
    "preparedAt",
    "expiresAt"
  ],
  "additionalProperties": false
}
