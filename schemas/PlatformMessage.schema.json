{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "platform",
        "inbox"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "unread": {
      "type": "boolean"
    },
    "publishedAt": {
      "type": "string"
    },
    "capturedAt": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "category",
    "title",
    "unread",
    "capturedAt"
  ],
  "additionalProperties": false
}
