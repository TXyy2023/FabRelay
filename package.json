{
  "name": "jlc-com-cli",
  "version": "0.2.0",
  "description": "Playwright-first CLI and TUI for the JLC PCB ordering workflow",
  "type": "module",
  "bin": {
    "jlc-cli": "dist/bin/jlc-cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "jlc",
    "pcb",
    "gerber",
    "playwright",
    "cli",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "gerber-to-svg": "^4.2.8",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "pcb-stackup": "^4.2.8",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "sharp": "^0.35.3",
    "whats-that-gerber": "^4.2.7",
    "yaml": "^2.9.0",
    "yauzl": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yazl": "^3.3.1"
  }
}
