{
  "name": "jlc-cli",
  "version": "1.0.0-dev.5",
  "description": "Unofficial JLC China PCB workflows for terminals and AI agents: login, Gerber, quotes and orders",
  "type": "module",
  "bin": {
    "jlc-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    ".md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "keywords": [
    "jlc-cli",
    "jlc",
    "pcb",
    "gerber",
    "agent-skills",
    "ai-agent",
    "cli",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "playwright": "^1.58.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TXyy2023/jlc-cli.git"
  },
  "homepage": "https://github.com/TXyy2023/jlc-cli#readme",
  "bugs": {
    "url": "https://github.com/TXyy2023/jlc-cli/issues"
  }
}
